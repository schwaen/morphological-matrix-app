{
  "name": "morphological-matrix-app",
  "private": true,
  "description": "Morphologische Matrix im Browser – gebaut mit Vite, veröffentlicht über GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json && node scripts/typecheck-logic.js",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/unit/*.test.js\"",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
